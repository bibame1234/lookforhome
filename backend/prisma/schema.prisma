generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum Role {
  LANDLORD
  TENANT
  DRIVER
  ADMIN
}

enum Gender {
  HOMME
  FEMME
}

enum HousingType {
  CHAMBRE_MODERNE
  CHAMBRE_SIMPLE
  STUDIO_MODERNE
  STUDIO_SIMPLE
  APPARTEMENT_MODERNE
  APPARTEMENT_SIMPLE
  LOCAL_COMMERCE
  LOCAL_AUTRE
}

enum ListingStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum VehicleType {
  TAXI
  VTC
  MOTO
  BUS
  CAMION
  AUTRE
}

model User {
  id           String   @id @default(cuid())
  name         String
  firstName    String?
  email        String   @unique
  password     String
  gender       Gender?
  whatsapp     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings      Listing[]           @relation("LandlordListings")
  submissions   Listing[]           @relation("SubmittedBy")
  vehicles      Vehicle[]           @relation("DriverVehicles")
  vehicleSubs   Vehicle[]           @relation("VehicleSubmittedBy")
  unlocked      UnlockedListing[]
  unlockedVeh   UnlockedVehicle[]
  favorites     Favorite[]
  visits        Visit[]
  notifications NotificationLog[]

  @@map("users")
}

model Listing {
  id             String        @id @default(cuid())
  type           HousingType
  bedrooms       Int?
  bathrooms      Int?
  livingRooms    Int?
  hasWater       Boolean       @default(true)
  hasElectricity Boolean       @default(true)
  neighborhood   String
  description    String        @db.Text
  visitPrice     Int           @default(2000)
  status         ListingStatus @default(PENDING)
  images         String[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?
  rejectReason   String?

  submittedById String?
  submittedBy   User?   @relation("SubmittedBy", fields: [submittedById], references: [id])
  landlordId    String?
  landlord      User?   @relation("LandlordListings", fields: [landlordId], references: [id])

  unlockedBy UnlockedListing[]
  favorites  Favorite[]
  visits     Visit[]

  @@map("listings")
}

model Vehicle {
  id           String        @id @default(cuid())
  type         VehicleType
  brand        String?
  model        String?
  plate        String?
  city         String
  description  String        @db.Text
  contactPrice Int           @default(1000)
  status       ListingStatus @default(PENDING)
  images       String[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publishedAt  DateTime?
  rejectReason String?

  submittedById String?
  submittedBy   User?  @relation("VehicleSubmittedBy", fields: [submittedById], references: [id])
  driverId      String?
  driver        User?  @relation("DriverVehicles", fields: [driverId], references: [id])

  unlockedBy UnlockedVehicle[]

  @@map("vehicles")
}

model UnlockedListing {
  id         String   @id @default(cuid())
  userId     String
  listingId  String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([userId, listingId])
  @@map("unlocked_listings")
}

model UnlockedVehicle {
  id         String   @id @default(cuid())
  userId     String
  vehicleId  String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@unique([userId, vehicleId])
  @@map("unlocked_vehicles")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([userId, listingId])
  @@map("favorites")
}

model Visit {
  id            String   @id @default(cuid())
  userId        String
  listingId     String
  amount        Int
  paymentMethod String?
  transactionId String?
  status        String   @default("SUCCESS")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@map("visits")
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String?
  channel   String
  message   String   @db.Text
  status    String   @default("SENT")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("notification_logs")
}

model Setting {
  id                 Int      @id @default(1)
  defaultVisitPrice  Int      @default(2000)
  defaultContactPrice Int     @default(1000)
  contactFree        Boolean  @default(false)
  supportWhatsapp    String   @default("+2376XXXXXXXX")
  supportSms         String   @default("+2376XXXXXXXX")
  adminCode          String   @default("LFH-ADMIN-2026")
  updatedAt          DateTime @updatedAt
  @@map("settings")
}
